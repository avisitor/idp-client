{
    "name": "avisitor/idp-client",
    "description": "Identity Provider (IDP) Client Package for secure authentication integration",
    "type": "library",
    "license": "proprietary",
    "version": "2.1.0",
    "authors": [
        {
            "name": "WorldSpot Organization",
            "email": "dev@worldspot.org"
        }
    ],
    "homepage": "https://github.com/avisitor/idp-client",
    "support": {
        "source": "https://github.com/avisitor/idp-client",
        "issues": "https://github.com/avisitor/idp-client/issues"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/avisitor/monolog-context.git"
        }
    ],
    "require": {
        "ext-curl": "*",
        "ext-pdo": "*",
        "php": ">=8.1",
        "avisitor/monolog-context": "^2.1",
        "firebase/php-jwt": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "WorldSpot\\IDPClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WorldSpot\\IDPClient\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "scripts": {
        "post-install-cmd": [
            "php vendor/avisitor/idp-client/install-auth.php"
        ],
        "post-update-cmd": [
            "php vendor/avisitor/idp-client/install-auth.php"
        ],
        "install-auth": [
            "php vendor/avisitor/idp-client/install-auth.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
